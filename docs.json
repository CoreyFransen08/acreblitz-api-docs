                "pages": [
                  "v2/api-reference/endpoint/portal-access",
                  "v2/api-reference/endpoint/portal-lock",
                  "v2/api-reference/endpoint/group-portal-lock",
                  "v2/api-reference/endpoint/drift-buffer"
