{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AcreBlitz API",
  "colors": {
    "primary": "#07C983",
    "light": "#07C983",
    "dark": "#0A1628"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/acreblitz_logo.png",
    "dark": "/logo/acreblitz_logo.png"
  },
  "api": {
    "mdx": {
      "server": "https://esa.acreblitz.com",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "ESA Check",
            "pages": [
              "api-reference/endpoint/esa-check"
            ]
          },
          {
            "group": "Reports",
            "pages": [
              "api-reference/endpoint/enlist-report",
              "api-reference/endpoint/runoff-report"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@acreblitz.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://www.acreblitz.com/contact"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.acreblitz.com"
    }
  }
}
