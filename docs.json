                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "ESA Check",
                "pages": [
                  "api-reference/endpoint/esa-check"
                ]
              },
              {
                "group": "Field Processing",
                "pages": [
                  "api-reference/endpoint/process-field"
                ]
              },
              {
                "group": "Reports",
                "pages": [
                  "api-reference/endpoint/enlist-report",
                  "api-reference/endpoint/runoff-report"
                ]
              }
            ]
          }
        ]
      },
      {
        "version": "V2",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
