{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AcreBlitz API",
  "colors": {
    "primary": "#07C983",
    "light": "#07C983",
    "dark": "#0A1628"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/acreblitz_logo.png",
    "dark": "/logo/acre_blitz_darkmode.png"
  },
  "api": {
