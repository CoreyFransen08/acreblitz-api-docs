                ]
              },
              {
                "group": "Integration guides",
                "pages": [
                  "v2/migration",
                  "v2/errors",
                  "v2/ai-agents"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "v2/api-reference/introduction"
                ]
              },
              {
                "group": "ESA checks",
                "pages": [
                  "v2/api-reference/endpoint/esa-check"
                ]
              },
              {
                "group": "Bulk checks",
                "pages": [
                  "v2/api-reference/endpoint/bulk-submit",
                  "v2/api-reference/endpoint/bulk-status",
